# AdGuard Home deploy parameters. Copy to .env, fill the real values, then:
#   ansible-vault encrypt servers/truenas/apps/adguard/.env
#
# None of these are compose env-vars (AdGuard runs host-networked with no
# ${VAR} in compose.yml). They are consumed by scripts/adguard_push_config.py,
# which renders AdGuardHome.yaml and pushes it to the box via open-terminal:
#   __ADGUARD_PASSWORD_HASH__ <- ADGUARD_PASSWORD_HASH
#   __TRUENAS_TS_IP__         <- TRUENAS_TS_IP
#
# ADGUARD_USERNAME / ADGUARD_PASSWORD are recorded for the human (the UI login);
# only the bcrypt hash lands in AdGuardHome.yaml. Regenerate the hash after
# changing the password:  python -c 'import bcrypt;print(bcrypt.hashpw(b"PW",bcrypt.gensalt(10)).decode())'
ADGUARD_USERNAME=admin
ADGUARD_PASSWORD=replace-me
ADGUARD_PASSWORD_HASH=replace-me-bcrypt-hash
# The `truenas-scale` Tailscale node's IPv4 (Tailscale admin console, or
# `tailscale ip -4` on the box). All *.bajaber.ca rewrites resolve to this.
TRUENAS_TS_IP=100.x.y.z
