# Frigate per-app secrets. Copy to .env, fill in, then: ansible-vault encrypt .env
#
# These are referenced from compose.yml as ${VAR} (reconciler substitutes at apply
# time) and surface to Frigate as {FRIGATE_*} env vars resolved in config.yml.
#
# go2rtc PASSWORD CAVEAT (TESTED): go2rtc does NOT percent-decode passwords in the
# go2rtc: streams section — it sends the value verbatim. So store the LITERAL
# password here, NOT a percent-encoded form. (Storing `%5E` for `^` makes go2rtc
# send the literal "%5E" and the camera rejects it: "wrong user/pass".)

# Reolink doorbell (192.168.1.123) — reuses HA's `haos` account (reolink user slots
# are capped). Store the LITERAL password; Frigate auto-encodes it for the ffmpeg input.
FRIGATE_DOOR_PASSWORD=replace-me

# Hikvision living_room (192.168.1.241), user `admin`.
FRIGATE_LIVING_PASSWORD=replace-me

# ONVIF outdoor (192.168.1.133), user `admin`.
FRIGATE_OUTDOOR_PASSWORD=replace-me

# Mosquitto broker password for user `homeassistant` (reuse the value from
# servers/truenas/apps/mosquitto/.env MQTT_PASSWORD).
FRIGATE_MQTT_PASSWORD=replace-me
