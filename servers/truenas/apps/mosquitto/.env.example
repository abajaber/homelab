# Mosquitto broker credentials. Copy to .env, set the real password, then:
#   ansible-vault encrypt servers/truenas/apps/mosquitto/.env
#
# Only MQTT_PASSWORD is consumed by compose.yml (as ${MQTT_PASSWORD}); the
# username is a literal in the compose. The `homeassistant` MQTT user is
# (re)created from this password on every container boot. Reuse the password
# the old HA add-on generated so HA's existing MQTT config entry stays valid.
MQTT_PASSWORD=replace-me
