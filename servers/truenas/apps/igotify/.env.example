# iGotify Notification Assist deploy secrets. Copy to .env, fill, then:
#   ansible-vault encrypt servers/truenas/apps/igotify/.env
#
# IGOTIFY_GOTIFY_CLIENT_TOKEN — a Gotify *client* token (Gotify UI -> Clients,
# NOT Apps). The assist opens a WebSocket to Gotify with this token to RECEIVE
# every message, then forwards it to Apple APNs (via SecNtfy) for the iGotify
# iOS app. App tokens only SEND; a client token is required to stream/receive.
IGOTIFY_GOTIFY_CLIENT_TOKEN=replace-me

# IGOTIFY_SECNTFY_TOKEN — SecNtfy device push token from the iGotify iOS app
# (Settings shows "NTFY-DEVICE-..."). Semicolon-join multiple devices. Needed for
# local-instance setups where the app can't self-register against the assist.
IGOTIFY_SECNTFY_TOKEN=replace-me
