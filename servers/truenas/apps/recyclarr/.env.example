# Recyclarr needs the API key of every instance it syncs. These are the same
# keys already stored in servers/truenas/apps/arr/.env — copied here because
# each app folder carries its own .env.
#
# 1. Copy to `.env` next to compose.yml.
# 2. Paste the values from:  ansible-vault view servers/truenas/apps/arr/.env
# 3. Encrypt with:  ansible-vault encrypt servers/truenas/apps/recyclarr/.env
#
# Unlike the arr stack's .env, these ARE referenced from compose.yml — they
# are substituted into the inline `recyclarr_yml` config at apply time.

SONARR_ANIME_API_KEY=replace-me
SONARR_TV_API_KEY=replace-me
RADARR_API_KEY=replace-me
