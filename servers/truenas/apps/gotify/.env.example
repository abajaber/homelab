# Gotify deploy secrets. Copy to .env, fill the real value, then:
#   ansible-vault encrypt servers/truenas/apps/gotify/.env
#
# GOTIFY_ADMIN_PASS — password for the seeded `admin` user. Substituted into
# GOTIFY_DEFAULTUSER_PASS in compose.yml. Only applied on FIRST db creation;
# change it later in the Gotify UI (Users), not here.
GOTIFY_ADMIN_PASS=replace-me
