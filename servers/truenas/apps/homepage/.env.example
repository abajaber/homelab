# Homepage widget credentials. Copy to `.env`, fill the real values, then:
#   ansible-vault encrypt servers/truenas/apps/homepage/.env
# Edit later with:
#   ansible-vault edit servers/truenas/apps/homepage/.env
#
# Every var here is referenced as {{HOMEPAGE_VAR_NAME}} from a homepage.* label
# (on the app's own compose) or from config/services.yaml. Homepage resolves the
# placeholder from THIS container's environment, so the cleartext key never sits
# in any committed compose/yaml. A var left at "replace-me" just means that one
# widget shows no data until you fill it — the tile (link) still works.
#
# --- LIVE: copy these straight from the apps that already vault them ---
# arr/.env  ->  ansible-vault view servers/truenas/apps/arr/.env
HOMEPAGE_VAR_SONARR_ANIME_KEY=replace-me   # = SONARR_ANIME_API_KEY
HOMEPAGE_VAR_SONARR_TV_KEY=replace-me      # = SONARR_TV_API_KEY
HOMEPAGE_VAR_RADARR_KEY=replace-me         # = RADARR_API_KEY
HOMEPAGE_VAR_BAZARR_KEY=replace-me         # = BAZARR_API_KEY
HOMEPAGE_VAR_PROWLARR_KEY=replace-me       # = PROWLARR_API_KEY
# authentik/.env -> AUTHENTIK_API_TOKEN (needs "Can view User" + "Can view Event")
HOMEPAGE_VAR_AUTHENTIK_KEY=replace-me

# --- MINT THESE in each app's UI, then paste here ---
# Lidarr  : Settings > General > Security > API Key
HOMEPAGE_VAR_LIDARR_KEY=replace-me
# slskd   : slskd.yml web.authentication.api_keys (role: readonly, cidr-restrict)
HOMEPAGE_VAR_SLSKD_KEY=replace-me
# Jellyfin: Dashboard > Advanced > API Keys
HOMEPAGE_VAR_JELLYFIN_KEY=replace-me
# Jellyseerr: Settings > General > API Key
HOMEPAGE_VAR_JELLYSEERR_KEY=replace-me
# Immich  : Account Settings > API Keys (grant server.statistics)
HOMEPAGE_VAR_IMMICH_KEY=replace-me
# Navidrome (Subsonic auth): salt = any random string; token = md5(password + salt)
HOMEPAGE_VAR_NAVIDROME_USER=replace-me
HOMEPAGE_VAR_NAVIDROME_TOKEN=replace-me
HOMEPAGE_VAR_NAVIDROME_SALT=replace-me
# Paperless-ngx: Settings > (user) > API Token  (or Django admin token)
HOMEPAGE_VAR_PAPERLESS_KEY=replace-me
# qBittorrent WebUI login (same as the web UI user/pass) — direct + vpn instances
HOMEPAGE_VAR_QBIT_DIRECT_USER=replace-me
HOMEPAGE_VAR_QBIT_DIRECT_PASS=replace-me
HOMEPAGE_VAR_QBIT_VPN_USER=replace-me
HOMEPAGE_VAR_QBIT_VPN_PASS=replace-me
# Gotify  : a CLIENT token (Apps/Clients) — used to read message stats
HOMEPAGE_VAR_GOTIFY_TOKEN=replace-me
# AdGuard Home: the web-UI admin login (cleartext; AdGuardHome.yaml only has the hash)
HOMEPAGE_VAR_ADGUARD_USER=replace-me
HOMEPAGE_VAR_ADGUARD_PASS=replace-me
# Home Assistant: profile > Long-Lived Access Tokens
HOMEPAGE_VAR_HASS_TOKEN=replace-me
