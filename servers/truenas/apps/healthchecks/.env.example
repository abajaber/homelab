# Healthchecks deploy secrets. Copy to .env, fill the real value, then:
#   ansible-vault encrypt servers/truenas/apps/healthchecks/.env
#
# HEALTHCHECKS_SECRET_KEY — Django SECRET_KEY, secures HTTP sessions / signing.
# Substituted into SECRET_KEY in compose.yml. Generate a strong random value:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
# Rotating it logs everyone out but is otherwise safe.
HEALTHCHECKS_SECRET_KEY=replace-me

# NOTE: the Gotify *application token* Healthchecks uses to push notifications is
# NOT stored here. Healthchecks keeps integrations in its own DB — you add the
# Gotify integration at runtime in the HC UI (Integrations -> Add -> Gotify) with
# URL http://gotify:80 and a token minted in the Gotify UI (Apps -> Create App).

# HEALTHCHECKS_API_KEY — project API key (HC UI -> Project Settings -> API Access).
# Used by tooling to create/manage checks and by the Homepage widget. Not a compose
# env-var. Read-write here; use a read-only key for the widget if you prefer.
HEALTHCHECKS_API_KEY=replace-me
